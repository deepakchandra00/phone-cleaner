{
  "expo": {
    "name": "Phone Cleaner",
    "slug": "phone-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./src/assets/icon.png",
    "scheme": "phonecleaner",
    "android": {
      "package": "com.phonecleaner.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.phonecleaner.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to support this free cleaner."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "1.9.25",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "revenueCatAndroidApiKey": "goog_xxxxxxxxxxxxxxxxxxxxx",
      "posthogKey": "",
      "sentryDsn": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3c8e8c02-411e-48fe-8879-536bcab009d9"
      }
    }
  }
}
