{
  "name": "phone-cleaner",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "ESLINT_USE_FLAT_CONFIG=false expo lint",
    "build:dev": "eas build --profile development --platform android --clear-cache",
    "build:preview": "eas build --profile preview --platform android --clear-cache",
    "build:prod": "eas build --profile production --platform android --clear-cache",
    "submit": "eas submit --platform android",
    "update": "eas update --branch production",
    "prebuild": "expo prebuild",
    "postinstall": "node scripts/patch-ws.cjs",
    "test": "node --experimental-strip-types --test 'src/__tests__/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.59.0",
    "android-storage": "./modules/android-storage",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-background-fetch": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "query-string": "^9.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.3.3",
    "react-native-pager-view": "8.0.2",
    "react-native-purchases": "^9.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "nativewind": "^4.1.23",
    "prettier": "^3.3.3",
    "react-native-dotenv": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "android-storage",
          "clsx"
        ]
      }
    }
  },
  "private": true
}
